# ============================================
# Default behavior — normalize everything to LF in the repo
# ============================================
* text=auto eol=lf

# ============================================
# Explicit text files (force LF regardless of OS)
# ============================================
*.txt      text eol=lf
*.md       text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.xml      text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.less     text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.vue      text eol=lf
*.py       text eol=lf
*.rb       text eol=lf
*.go       text eol=lf
*.rs       text eol=lf
*.java     text eol=lf
*.kt       text eol=lf
*.c        text eol=lf
*.h        text eol=lf
*.cpp      text eol=lf
*.hpp      text eol=lf
*.php      text eol=lf
*.sql      text eol=lf
*.graphql  text eol=lf
*.proto    text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
.editorconfig text eol=lf

# Shell scripts MUST stay LF (break on Windows CRLF when executed in WSL/Linux/CI)
*.sh       text eol=lf
*.bash     text eol=lf

# ============================================
# Windows-specific scripts — keep CRLF
# ============================================
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ============================================
# C# / .NET — Windows-origin projects typically prefer CRLF
# (Change to eol=lf if your team standardizes otherwise)
# ============================================
*.cs       text eol=crlf
*.csproj   text eol=crlf
*.sln      text eol=crlf

# ============================================
# Documentation / config that must never be auto-converted
# ============================================
Makefile   text eol=lf
Dockerfile text eol=lf
*.env      text eol=lf

# ============================================
# Treat these as generated / vendored — exclude from diff stats & GitHub language stats
# ============================================
package-lock.json  linguist-generated=true
yarn.lock           linguist-generated=true
pnpm-lock.yaml       linguist-generated=true
Cargo.lock           linguist-generated=true
*.min.js             linguist-generated=true -diff
*.min.css            linguist-generated=true -diff
dist/**              linguist-generated=true -diff
build/**             linguist-generated=true -diff
vendor/**            linguist-vendored=true

# ============================================
# Binary files — never touch, never diff as text
# ============================================
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.webp     binary
*.svg      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tar      binary
*.7z       binary
*.rar      binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
*.bin      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.eot      binary
*.mp3      binary
*.mp4      binary
*.mov      binary
*.avi      binary
*.db       binary
*.sqlite   binary
*.pyc      binary
*.class    binary
*.jar      binary

# ============================================
# Diff improvements for specific languages (optional but nice)
# Shows function/class context in diff hunks
# ============================================
*.py  diff=python
*.rb  diff=ruby
*.php diff=php
*.cs  diff=csharp
*.java diff=java
*.go  diff=golang
*.rs  diff=rust

